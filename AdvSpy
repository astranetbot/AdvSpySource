-- [[ ENGINE: V3 HOOKING ]] --
local function LogRemote(Remote, Method, Args)
    local btn = Instance.new("TextButton", LeftPanel)
    btn.Size = UDim2.new(1, -5, 0, 28)
    btn.BackgroundColor3 = SecondaryColor
    btn.Text = " " .. Remote.Name
    btn.TextColor3 = TextColor
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    btn.MouseButton1Click:Connect(function()
        local formattedArgs = FormatTable(Args)
        local path = Remote:GetFullName()
        
        local info = "Remote: " .. path .. "\n"
        info = info .. "Method: " .. Method .. "\n"
        info = info .. "Arguments: " .. formattedArgs .. "\n\n"
        info = info .. "-- AUTO-SCRIPT --\n"
        
        local scriptGen = "local args = " .. formattedArgs .. "\n"
        scriptGen = scriptGen .. "game." .. path .. ":" .. Method .. "(unpack(args))"
        
        currentCode = scriptGen
        CodeText.Text = info .. scriptGen
        RightPanel.CanvasSize = UDim2.new(0, 0, 0, CodeText.TextBounds.Y + 20)
    end)
    LeftPanel.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y)
end

-- SimpleSpy V3 Metatable Hook
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Method = getnamecallmethod()
    local Args = {...}

    if Method == "FireServer" or Method == "InvokeServer" then
        LogRemote(Self, Method, Args)
    end
    return OldNamecall(Self, ...)
end)

-- Dragging Logic
local dragging, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

