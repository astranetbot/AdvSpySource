-- SimpleSpy V3 internal formatting
local function rawtostring(v)
    return tostring(v)
end

local function FormatTable(tbl)
    local success, result = pcall(function()
        return HttpService:JSONEncode(tbl)
    end)
    return success and result or "{Table Content Unreadable}"
end

