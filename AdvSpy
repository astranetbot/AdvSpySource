-- This is the "brain" that catches the remotes
local function NewRemoteLog(Remote, Method, Args)
    local RemoteBtn = Instance.new("TextButton", LogList)
    RemoteBtn.Size = UDim2.new(1, 0, 0, 25)
    RemoteBtn.Text = Remote.Name
    RemoteBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    RemoteBtn.TextColor3 = Color3.new(1, 1, 1)
    
    RemoteBtn.MouseButton1Click:Connect(function()
        print("Remote: " .. Remote:GetFullName())
        print("Method: " .. Method)
        -- In a full version, this would show the code in your right panel
    end)
end

-- Hooking the Remotes (Metatable Hook)
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(Self, ...)
    local Method = getnamecallmethod()
    local Args = {...}

    if Method == "FireServer" or Method == "InvokeServer" then
        NewRemoteLog(Self, Method, Args)
    end

    return OldNamecall(Self, ...)
end)

